{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://KRONOSPROYECT.github.io/MD-33/schemas/folio.schema.json",
    "title": "KRONOS 360 - Folio Schema",
    "description": "Esquema de validación para folios de trazabilidad",
    "version": "1.0.0",
    "genesisHash": "KRONOS-MD-33-467162326",
    "type": "object",
    "required": ["id", "estado", "creado"],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^AF-[0-9]{4}-[A-Z0-9]{4}-[0-9]{3}-[0-9]{2}$",
            "description": "Identificador único del folio con checksum",
            "examples": ["AF-2026-X9K2-482-73"]
        },
        "estado": {
            "type": "string",
            "enum": ["activo", "finalizado", "revocado", "expirado", "sospechoso"],
            "description": "Estado actual del folio",
            "default": "activo"
        },
        "creado": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de creación en ISO 8601"
        },
        "productId": {
            "type": "string",
            "maxLength": 64,
            "description": "Identificador del producto asociado"
        },
        "nivelConfianza": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Nivel de confianza del folio (0-100)",
            "default": 100
        },
        "escaneos": {
            "type": "array",
            "description": "Historial de escaneos del folio",
            "items": {
                "$ref": "#/definitions/escaneo"
            }
        },
        "seal": {
            "type": "object",
            "description": "Sello cuántico MD-33 del folio",
            "properties": {
                "hash": {
                    "type": "string",
                    "pattern": "^MD33-[A-F0-9]{32}$"
                },
                "previousHash": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string",
                    "format": "date-time"
                },
                "rootSignature": {
                    "type": "string",
                    "const": "KRONOS-MD-33-467162326"
                },
                "version": {
                    "type": "string",
                    "const": "1.0.0"
                }
            },
            "required": ["hash", "previousHash", "timestamp"]
        },
        "revocadoEn": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de revocación (si aplica)"
        },
        "revocadoPor": {
            "type": "string",
            "description": "Razón de revocación",
            "enum": ["compromised", "duplicate", "cancelled", "stolen", "suspicious", "expired"]
        },
        "metadata": {
            "type": "object",
            "description": "Metadatos adicionales",
            "additionalProperties": true
        },
        "_offline": {
            "type": "boolean",
            "description": "Indica si el folio fue creado en modo offline"
        },
        "_version": {
            "type": "string",
            "const": "1.0.0"
        }
    },
    "definitions": {
        "escaneo": {
            "type": "object",
            "required": ["timestamp", "ubicacion"],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "format": "date-time"
                },
                "ubicacion": {
                    "type": "string",
                    "description": "Ubicación del escaneo"
                },
                "descripcion": {
                    "type": "string",
                    "description": "Descripción del punto de control"
                },
                "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                },
                "lng": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                },
                "hash": {
                    "type": "string",
                    "description": "Hash del escaneo"
                }
            }
        }
    },
    "if": {
        "properties": { "estado": { "const": "revocado" } }
    },
    "then": {
        "required": ["revocadoEn", "revocadoPor"]
    }
}