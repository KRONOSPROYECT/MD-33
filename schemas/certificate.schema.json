{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://KRONOSPROYECT.github.io/MD-33/schemas/certificate.schema.json",
    "title": "KRONOS 360 - Certificate Schema",
    "description": "Esquema de validación para certificados de autenticidad",
    "version": "1.0.0",
    "genesisHash": "KRONOS-MD-33-467162326",
    "type": "object",
    "required": ["certificateId", "folioId", "issuedAt", "issuedBy", "status"],
    "properties": {
        "certificateId": {
            "type": "string",
            "pattern": "^CERT-[0-9]{4}-[A-Z0-9]{8}$",
            "description": "Identificador único del certificado"
        },
        "folioId": {
            "type": "string",
            "description": "ID del folio asociado",
            "pattern": "^AF-[0-9]{4}-[A-Z0-9]{4}-[0-9]{3}-[0-9]{2}$"
        },
        "issuedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de emisión del certificado"
        },
        "issuedBy": {
            "type": "string",
            "description": "Entidad que emite el certificado"
        },
        "status": {
            "type": "string",
            "enum": ["valid", "pending", "revoked", "expired"],
            "description": "Estado del certificado"
        },
        "validUntil": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de expiración del certificado"
        },
        "productInfo": {
            "type": "object",
            "description": "Información del producto",
            "properties": {
                "name": { "type": "string" },
                "sku": { "type": "string" },
                "batch": { "type": "string" },
                "manufacturer": { "type": "string" }
            }
        },
        "hash": {
            "type": "string",
            "description": "Hash del certificado",
            "pattern": "^MD33-[A-F0-9]{32}$"
        },
        "previousHash": {
            "type": "string",
            "description": "Hash del certificado anterior"
        },
        "metadata": {
            "type": "object",
            "description": "Metadatos adicionales",
            "additionalProperties": true
        },
        "revokedAt": {
            "type": "string",
            "format": "date-time"
        },
        "revokedReason": {
            "type": "string",
            "enum": ["compromised", "duplicate", "cancelled"]
        }
    }
}