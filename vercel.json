# Crear el archivo vercel.json
cat > vercel.json << 'EOF'
{
    "version": 2,
    "builds": [
        { "src": "*.html", "use": "@vercel/static" },
        { "src": "js/*.js", "use": "@vercel/static" },
        { "src": "css/*.css", "use": "@vercel/static" },
        { "src": "assets/**/*", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/", "dest": "/index.html" },
        { "src": "/(.*)", "dest": "/$1" }
    ]
}
EOF

git add vercel.json
git commit -m "fix: Vercel config para HTML puro"
git push origin main